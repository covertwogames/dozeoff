<?xml version="1.0" encoding="utf-8"?>
<!--
    DozeOff's settings record what was set up on this phone: permissions,
    battery exemption and manufacturer steps. None of that carries over to a
    new phone, so the settings must not either, or the new phone skips
    onboarding while nothing is actually allowed. Cloud backup is already off
    (allowBackup="false"); this also covers phone-to-phone transfers, which
    some manufacturers run regardless of allowBackup on Android 12 and later.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="dozeoff_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="dozeoff_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
